
name: Build Calculateur Menuiserie Aluminium MDG

on:
  workflow_dispatch:
  push:
    paths:
      - 'CALCULATEUR_MENUISERIE_ALUMINIUM_MDG.zip'
      - '.github/workflows/build-calculateur.yml'

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Java
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Install Android SDK
        run: |
          yes | sudo ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager --licenses || true
          sudo ${ANDROID_HOME}/cmdline-tools/latest/bin/sdkmanager "platform-tools" "platforms;android-35" "build-tools;35.0.0"

      - name: Extract project
        run: |
          mkdir project
          unzip -q CALCULATEUR_MENUISERIE_ALUMINIUM_MDG.zip -d project
          find project -name gradlew

      - name: Build APK
        run: |
          cd project
          GRADLEW=$(find . -name gradlew -type f | head -n 1)
          test -n "$GRADLEW"
          cd "$(dirname "$GRADLEW")"
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: CALCULATEUR-MENUISERIE-ALUMINIUM-MDG
          path: project/**/build/outputs/apk/debug/*.apk

